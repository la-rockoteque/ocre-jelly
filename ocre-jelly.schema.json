{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ocre-jelly configuration",
  "description": "Layers, later wins: ~/.claude/ocre-jelly.json, <repo>/.claude/ocre-jelly.json (committed), <repo>/.claude/ocre-jelly.local.json (personal).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Inject the prose rules into sessions and subagents."
    },
    "locales": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
      },
      "examples": [
        [
          "en-CA",
          "fr-CA"
        ]
      ],
      "description": "Locale tags; each paragraph uses the one whose language it is written in. Empty: detect en/fr without regional checks."
    },
    "glossary": {
      "type": [
        "string",
        "null"
      ],
      "description": "Ubiquitous-language file, from the repo root. Null: docs/ubiquitous-language.md or UBIQUITOUS-LANGUAGE.md."
    },
    "modules": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "on",
          "off",
          "auto"
        ]
      },
      "description": "Module name to on, off or auto. See `modules.py list`."
    },
    "inject": {
      "type": "string",
      "enum": [
        "index",
        "full"
      ],
      "default": "index",
      "description": "index: one line per module (progressive disclosure). full: inline every active module."
    },
    "subagents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inject": {
          "type": "boolean",
          "default": true
        },
        "matcher": {
          "type": [
            "string",
            "null"
          ],
          "description": "Regex on the subagent type; only matching subagents get the rules."
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sentence_words": {
          "type": "integer",
          "minimum": 1,
          "default": 25
        },
        "instruction_words": {
          "type": "integer",
          "minimum": 1,
          "default": 20
        },
        "em_dash_per_paragraph": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "length_hits_per_file": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        }
      }
    },
    "severity": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "hard",
          "soft",
          "off"
        ]
      },
      "description": "Category to hard, soft or off, e.g. {\"em-dash\": \"off\"}."
    },
    "ignore_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Globs from the repo root that docs mode skips."
    },
    "protected_terms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Words never flagged or respelled."
    },
    "commits": {
      "type": "object",
      "additionalProperties": false,
      "description": "Commit-message checks (commitmsg.py and the commit-msg hook).",
      "properties": {
        "enforce": {
          "type": "string",
          "enum": [
            "off",
            "warn",
            "block"
          ],
          "default": "warn",
          "description": "off: no output. warn: print findings, never block. block: exit 1 (reject the commit) on a hard finding."
        },
        "convention": {
          "type": "string",
          "enum": [
            "auto",
            "conventional",
            "gitmoji",
            "none"
          ],
          "default": "auto",
          "description": "auto follows the conventional-commits and gitmoji modules."
        },
        "subject_max": {
          "type": "integer",
          "minimum": 1,
          "default": 72
        },
        "subject_target": {
          "type": "integer",
          "minimum": 1,
          "default": 50
        },
        "body_wrap": {
          "type": "integer",
          "minimum": 1,
          "default": 72
        },
        "types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Allowed Conventional Commits types. Empty: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert."
        }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where /ocre-jelly feedback sends people. The script only pre-fills the form; the user submits it.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "form_url": {
          "type": "string",
          "pattern": "^https://",
          "description": "The form's viewform URL."
        },
        "entry": {
          "type": "string",
          "pattern": "^[0-9]+$",
          "default": "1018508464",
          "description": "The id of the form's paragraph field (entry.<id>)."
        }
      }
    }
  }
}
